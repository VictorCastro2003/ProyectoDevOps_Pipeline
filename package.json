{
  "name": "express-pipeline-ci",
  "version": "1.0.0",
  "description": "Express login + sqlite + CI/CD demo",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --runInBand",
    "test:junit": "jest --runInBand --reporters=default --reporters=jest-junit",
    "lint": "eslint . --ext .js || true",
    "ci": "npm run lint && npm run test:junit"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VictorCastro2003/ProyectoDevOps_Pipeline.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-junit": "^13.2.0",
    "supertest": "^6.3.4"
  }
}
